# SMTP-Zugangsdaten für den E-Mail-Versand
# Kopiere diese Datei als .env.local und trage deine Daten ein

# Für Gmail: smtp.gmail.com, Port 587
# Tipp: Bei Gmail ein App-Passwort unter Kontoeinstellungen → Sicherheit erstellen
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=deine-absender@gmail.com
SMTP_PASS=dein-app-passwort

# Für andere Anbieter (z.B. Strato, IONOS, Hetzner):
# SMTP_HOST=smtp.strato.de
# SMTP_PORT=587
# SMTP_USER=box@plasma-energie.de
# SMTP_PASS=dein-passwort

# --- Vercel Blob (Datei-Upload der Rechnungen) ---
# Auf Vercel automatisch gesetzt, sobald der private Blob-Store mit dem Projekt
# verbunden ist. Für lokales Testen: `vercel env pull .env.local` oder Token
# aus dem Vercel-Dashboard (Storage → Store → .env.local) hier eintragen.
BLOB_READ_WRITE_TOKEN=

# Signiert die Download-Links der Rechnungen (fälschungssicher). Im
# Vercel-Projekt unter Settings → Environment Variables anlegen.
DOWNLOAD_SECRET=

# Schützt den automatischen 30-Tage-Löschlauf (/api/cleanup) vor Fremdaufruf.
# Vercel sendet diesen Wert automatisch beim Cron-Aufruf mit.
CRON_SECRET=
