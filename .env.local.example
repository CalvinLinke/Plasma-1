# E-Mail-Versand über Microsoft Graph (App-only, Client-Credentials)
# Kopiere diese Datei als .env.local und trage die Werte der Entra-App ein.
#
# Hintergrund: box@plasma-energie.de ist ein freigegebenes Postfach (kein
# eigener Login) und der Tenant erzwingt MFA — klassisches SMTP scheidet aus.
# Stattdessen sendet eine Entra-App per Graph als box@ (kein Benutzer-Login).
# Voraussetzung: App-Registrierung mit Application-Permission "Mail.Send"
# (Microsoft Graph) + erteilter Admin-Zustimmung.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_UPN=box@plasma-energie.de

# --- Vercel Blob (Datei-Upload der Rechnungen) ---
# Auf Vercel automatisch gesetzt, sobald der private Blob-Store mit dem Projekt
# verbunden ist. Für lokales Testen: `vercel env pull .env.local` oder Token
# aus dem Vercel-Dashboard (Storage → Store → .env.local) hier eintragen.
BLOB_READ_WRITE_TOKEN=

# Signiert die Download-Links der Rechnungen (fälschungssicher). Im
# Vercel-Projekt unter Settings → Environment Variables anlegen.
DOWNLOAD_SECRET=

# Schützt den automatischen 30-Tage-Löschlauf (/api/cleanup) vor Fremdaufruf.
# Vercel sendet diesen Wert automatisch beim Cron-Aufruf mit.
CRON_SECRET=

# --- Notion (Partner-Anfragen aus Postfach) ---
# Internal Integration Secret aus https://www.notion.so/my-integrations
NOTION_API_KEY=
# Seiten-ID des Teamspace/Ordners, mit dem die Integration verbunden ist.
# Aus dem Notion-Link: ...-92decf80f9e58385ad14019631c6e46a
NOTION_PARENT_PAGE_ID=92decf80-f9e5-8385-ad14-019631c6e46a
# Optional — wird beim ersten Lauf automatisch angelegt, dann hier eintragen.
NOTION_LEADS_DATABASE_ID=
